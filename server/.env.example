PORT=5001
# Local testing only: both settings are required to skip first-login email codes.
# Accounts remain unverified and will still require verification in production.
NODE_ENV=development
SKIP_EMAIL_VERIFICATION=false
JWT_SECRET=your_jwt_secret_here
# Optional separate encryption secret for app passwords saved in admin settings.
# Keep this stable. If empty, JWT_SECRET is used.
EMAIL_SETTINGS_KEY=
ADMIN_CODE=your_admin_secret_code
MONGO_URI=mongodb://127.0.0.1:27017/language-lms
# Optional read-only cloud source for scripts/importCloudContent.js.
MONGO_URI_ATLAS=
# SMTP takes precedence over Resend when SMTP_HOST is set. See docs/smtp.md.
SMTP_HOST=
SMTP_PORT=587
# Leave empty to infer true for port 465, false for other ports.
SMTP_SECURE=
# Require STARTTLS when SMTP_SECURE is false. Set false only for a trusted local relay.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Optional alternative when SMTP is not configured.app
RESEND_API_KEY=
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GEMINI_API_KEY=your_gemini_api_key_optional
CLOUDINARY_URL=your_cloudinary_url_optional
# Daily practice push notifications. Generate keys once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact URL sent to push services; defaults to CLIENT_URL.
VAPID_SUBJECT=
# Number of proxies in front of the server (Render: 1). Set 0 when nothing sits in front of it.
TRUST_PROXY=
# Long random string; the scheduled GitHub workflow sends it to /api/push/run.
PUSH_CRON_SECRET=
# Natural Mandarin voice (Azure AI Speech, free F0 tier is enough). Leave blank to use the browser voice.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
