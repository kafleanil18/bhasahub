PORT=5001
JWT_SECRET=your_jwt_secret_here
# Optional separate encryption secret for app passwords saved in admin settings.
# Keep this stable. If empty, JWT_SECRET is used.
EMAIL_SETTINGS_KEY=
ADMIN_CODE=your_admin_secret_code
MONGO_URI=mongodb://127.0.0.1:27017/language-lms
# SMTP takes precedence over Resend when SMTP_HOST is set. See docs/smtp.md.
SMTP_HOST=
SMTP_PORT=587
# Leave empty to infer true for port 465, false for other ports.
SMTP_SECURE=
# Require STARTTLS when SMTP_SECURE is false. Set false only for a trusted local relay.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Optional alternative when SMTP is not configured.app
RESEND_API_KEY=
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GEMINI_API_KEY=your_gemini_api_key_optional
CLOUDINARY_URL=your_cloudinary_url_optional
